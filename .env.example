# Community Research environment variables.
#
# Copy to .env for local development. Placeholders only - never commit real values.
#
# Where values come from (first match wins):
#   1. Process environment (Render, CI, `op run`, your shell)
#   2. Project env file: ENV_FILE if set, otherwise <project root>/.env
#   3. Shared credentials file: SHARED_ENV_FILE if set, otherwise
#      $XDG_CONFIG_HOME/secrets/reddit.env (XDG_CONFIG_HOME defaults to ~/.config)
#
# Keep Reddit credentials in the shared file so other projects can reuse them:
#   scripts/move-reddit-creds-to-shared.sh
#
# ENV_FILE=/path/to/alternate.env
# SHARED_ENV_FILE=~/.config/secrets/reddit.env

# --- Reddit credentials (API service) ----------------------------------------
# Get these from https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID="your_client_id_here"
REDDIT_CLIENT_SECRET="your_client_secret_here"
REDDIT_USER_AGENT="your_app_name_here"

# Optional: not needed for read-only access
# REDDIT_USERNAME="your_username"
# REDDIT_PASSWORD="your_password"

# --- Reddit behaviour (API service) ------------------------------------------
# REDDIT_TIMEOUT_SECONDS=10
# Max "load more comments" expansions per thread fetch; "none" = unlimited
# REDDIT_REPLACE_MORE_LIMIT=32
# MCP_RETRY_ATTEMPTS=3
# MCP_RETRY_BACKOFF_SECONDS=0.5
# MCP_MAX_COMMENTS=2000
# MCP_MAX_SEARCH_LIMIT=100
# Where / and /about redirect to
# COMMUNITY_RESEARCH_FRONTEND_URL=https://community-research-frontend.onrender.com

# --- MCP server ---------------------------------------------------------------
# COMMUNITY_RESEARCH_API_URL=https://community-research.onrender.com
# MCP_API_TIMEOUT_SECONDS=10
# MCP_API_RETRY_ATTEMPTS=1
# MCP_API_RETRY_BACKOFF_SECONDS=0.5

# --- Shared -------------------------------------------------------------------
# Render sets PORT; MCP_PORT is the local fallback for the MCP server
# PORT=8000
# MCP_PORT=8000
